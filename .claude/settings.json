{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Bash(git status)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(find*)",
      "Bash(grep*)",
      "Bash(command -v*)",
      "Bash(echo*)"
    ],
    "ask": [
      "Write(**)",
      "Edit(**)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(rm*)",
      "Bash(rmdir*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(curl*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(git push --force*)",
      "Bash(rm -rf /*)"
    ],
    "defaultMode": "default"
  }
}
